{
  "functions": {
    "api/index.js": {
      "includeFiles": "public/templates/micro-portal/index.html"
    }
  },
  "rewrites": [
    {
      "source": "/desa/:slug/dokumen",
      "destination": "/api/index.js"
    },
    {
      "source": "/desa/:slug",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    }
  ]
}
