PORT=5000
NODE_ENV=development
# Generate a random secret (at least 32 characters); never use a shared default.
JWT_SECRET=
# Only for explicit administrator creation; never committed with real values.
ADMIN_BPS_EMAIL=
ADMIN_BPS_PASSWORD=
JWT_EXPIRES_IN=1d

# Database Configuration
# Supported dialects: sqlite, mysql, postgres
DB_DIALECT=mysql
DB_STORAGE=./database.sqlite

# Configurations for MySQL / PostgreSQL (if DB_DIALECT is set to mysql or postgres)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=bps_village_gallery

# Google Sheets API Configuration
GOOGLE_SHEET_ID=1SBE8QE_ICEvizjMHDH6kTur0tsdiuZ0zIqqKlfiyQJM
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/your_deployment_id/exec
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account_email_here
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"

# Konten Website Saya memakai Sheets API langsung (service account), bukan GOOGLE_SCRIPT_URL.
# Aktifkan Sheets API lalu bagikan setiap spreadsheet desa kepada service account sebagai Viewer.
# Panduan: WEBSITE_DESA_SETUP.md
