PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=1d

# Database Configuration
# Supported dialects: sqlite, mysql, postgres
DB_DIALECT=sqlite
DB_STORAGE=./database.sqlite

# Configurations for MySQL / PostgreSQL (if DB_DIALECT is set to mysql or postgres)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=password
DB_NAME=bps_village_gallery

# Google Sheets API Configuration
GOOGLE_SHEET_ID=1SBE8QE_ICEvizjMHDH6kTur0tsdiuZ0zIqqKlfiyQJM
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/your_deployment_id/exec
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account_email_here
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"
